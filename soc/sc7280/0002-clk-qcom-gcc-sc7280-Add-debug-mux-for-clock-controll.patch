+#include "clk-debug.h"
 #include "clk-rcg.h"
 #include "clk-regmap-divider.h"
 #include "common.h"
@@ -787,6 +788,28 @@ static struct clk_branch disp_cc_sleep_clk = {
 	},
 };
 
+static struct clk_debug_mux disp_cc_debug_mux = {
+	.debug_offset = 0x7000,
+	.post_div_offset = 0x3000,
+	.cbcr_offset = 0x3004,
+	.src_sel_mask = 0xff,
