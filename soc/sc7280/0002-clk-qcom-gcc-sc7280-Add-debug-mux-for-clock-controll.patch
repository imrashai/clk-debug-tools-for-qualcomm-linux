From 509e2a5da1a056a7f747e2d9489723d0981a6140 Mon Sep 17 00:00:00 2001
From: Taniya Das <taniya.das@oss.qualcomm.com>
Date: Sat, 8 Aug 2026 16:33:53 +0530
Subject: [PATCH 2/3] clk: qcom: gcc-sc7280: Add debug mux for clock
 controllers

Add debug mux support for clock controllers to measure
the clock frequencies on SC7280 platform.

Signed-off-by: Taniya Das <taniya.das@oss.qualcomm.com>
---
 drivers/clk/qcom/camcc-sc7280.c   | 24 ++++++++++++++++
 drivers/clk/qcom/dispcc-sc7280.c  | 24 ++++++++++++++++
 drivers/clk/qcom/gcc-sc7280.c     | 47 +++++++++++++++++++++++++++++++
 drivers/clk/qcom/gpucc-sc7280.c   | 24 ++++++++++++++++
 drivers/clk/qcom/videocc-sc7280.c | 24 ++++++++++++++++
 5 files changed, 143 insertions(+)

diff --git a/drivers/clk/qcom/camcc-sc7280.c b/drivers/clk/qcom/camcc-sc7280.c
index 55545f5fdb98..a1bd7673edcf 100644
--- a/drivers/clk/qcom/camcc-sc7280.c
+++ b/drivers/clk/qcom/camcc-sc7280.c
@@ -16,6 +16,7 @@
 
 #include "clk-alpha-pll.h"
 #include "clk-branch.h"
+#include "clk-debug.h"
 #include "clk-rcg.h"
 #include "common.h"
 #include "gdsc.h"
@@ -2246,6 +2247,28 @@ static struct clk_branch cam_cc_sleep_clk = {
 	},
 };
 
+static struct clk_debug_mux cam_cc_debug_mux = {
+	.debug_offset = 0xd000,
+	.post_div_offset = 0xd004,
+	.cbcr_offset = 0xd008,
+	.src_sel_mask = 0xff,
+	.src_sel_shift = 0,
+	.post_div_mask = 0xf,
+	.post_div_shift = 0,
+	.post_div_val = 4,
+	.clkr = {
+		.hw.init = &(const struct clk_init_data) {
+			.name = "cam_cc_debug_mux",
+			.parent_data = &(const struct clk_parent_data) {
+				.fw_name = "gcc_debug_mux",
+				.name = "gcc_debug_mux",
+			},
+			.num_parents = 1,
+			.ops = &clk_debug_mux_ops,
+		},
+	},
+};
+
 static struct gdsc cam_cc_titan_top_gdsc = {
 	.gdscr = 0xc194,
 	.en_rest_wait_val = 0x2,
@@ -2432,6 +2455,7 @@ static struct clk_regmap *cam_cc_sc7280_clocks[] = {
 	[CAM_CC_SLEEP_CLK_SRC] = &cam_cc_sleep_clk_src.clkr,
 	[CAM_CC_SLOW_AHB_CLK_SRC] = &cam_cc_slow_ahb_clk_src.clkr,
 	[CAM_CC_XO_CLK_SRC] = &cam_cc_xo_clk_src.clkr,
+	[CAM_CC_DEBUG_MUX] = &cam_cc_debug_mux.clkr,
 };
 
 static struct gdsc *cam_cc_sc7280_gdscs[] = {
