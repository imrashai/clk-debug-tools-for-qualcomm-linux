 #include "clk-branch.h"
+#include "clk-debug.h"
 #include "clk-pll.h"
 #include "clk-rcg.h"
 #include "clk-regmap.h"
@@ -1699,6 +1700,28 @@ static struct clk_branch cam_cc_titan_top_accu_shift_clk = {
 	},
 };
 
+static struct clk_debug_mux cam_cc_debug_mux = {
+	.debug_offset = 0x150f8,
+	.post_div_offset = 0x14004,
+	.cbcr_offset = 0x14008,
+	.src_sel_mask = 0xff,
+	.src_sel_shift = 0,
+	.post_div_mask = 0xf,
+	.post_div_shift = 0,
+	.post_div_val = 4,
+	.clkr = {
+		.hw.init = &(const struct clk_init_data) {
+			.name = "cam_cc_debug_mux",
+			.parent_data = &(const struct clk_parent_data) {
+				.fw_name = "gcc_debug_mux",
+				.name = "gcc_debug_mux",
+			},
+			.num_parents = 1,
+			.ops = &clk_debug_mux_ops,
+		},
+	},
+};
+
 static struct gdsc cam_cc_titan_top_gdsc = {
 	.gdscr = 0x131bc,
 	.en_rest_wait_val = 0x2,
@@ -1796,6 +1819,7 @@ static struct clk_regmap *cam_cc_sa8775p_clocks[] = {
 	[CAM_CC_TITAN_TOP_ACCU_SHIFT_CLK] = NULL,
 	[CAM_CC_XO_CLK_SRC] = &cam_cc_xo_clk_src.clkr,
 	[CAM_CC_QDSS_DEBUG_XO_CLK] = &cam_cc_qdss_debug_xo_clk.clkr,
+	[CAM_CC_DEBUG_MUX] = &cam_cc_debug_mux.clkr,
 };
 
