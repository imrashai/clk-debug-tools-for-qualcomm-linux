diff --git a/drivers/clk/qcom/gcc-sa8775p.c b/drivers/clk/qcom/gcc-sa8775p.c
index d7d1ba6ad6af..dc60fe4e6197 100644
--- a/drivers/clk/qcom/gcc-sa8775p.c
+++ b/drivers/clk/qcom/gcc-sa8775p.c
@@ -5,6 +5,7 @@
  */
 
 #include <linux/clk-provider.h>
+#include <linux/mfd/syscon.h>
 #include <linux/module.h>
 #include <linux/mod_devicetable.h>
 #include <linux/of.h>
@@ -15,6 +16,7 @@
 
 #include "clk-alpha-pll.h"
 #include "clk-branch.h"
+#include "clk-debug.h"
 #include "clk-rcg.h"
 #include "clk-regmap.h"
 #include "clk-regmap-divider.h"
@@ -4201,6 +4203,41 @@ static struct clk_branch gcc_video_axi1_clk = {
 	},
 };
 
+static struct measure_clk_data debug_mux_priv = {
+	.ctl_reg = 0x72038,
+	.status_reg = 0x7203c,
+	.xo_div4_cbcr = 0x6e008,
+};
+
+static struct clk_debug_mux mc_cc_debug_mux = {
+	.period_offset = 0x50,
+	.mux_sel = true,
+	.clkr = {
+		.hw.init = &(struct clk_init_data) {
+			.name = "mc_cc_debug_mux",
+			.ops = &clk_debug_mux_ops,
+		},
+	},
+};
+
+static struct clk_debug_mux gcc_debug_mux = {
+	.priv = &debug_mux_priv,
+	.debug_offset = 0x72024,
+	.post_div_offset = 0x6e000,
+	.cbcr_offset = 0x6e004,
+	.src_sel_mask = 0x1fff,
+	.src_sel_shift = 0,
+	.post_div_mask = 0xf,
+	.post_div_shift = 0,
+	.post_div_val = 2,
+	.clkr = {
+		.hw.init = &(const struct clk_init_data) {
+			.name = "gcc_debug_mux",
+			.ops = &clk_debug_mux_ops,
+		},
+	},
+};
+
 static struct gdsc pcie_0_gdsc = {
 	.gdscr = 0xa9004,
 	.collapse_ctrl = 0x4b104,
@@ -4549,6 +4586,7 @@ static struct clk_regmap *gcc_sa8775p_clocks[] = {
 	[GCC_USB_CLKREF_EN] = &gcc_usb_clkref_en.clkr,
 	[GCC_VIDEO_AXI0_CLK] = &gcc_video_axi0_clk.clkr,
 	[GCC_VIDEO_AXI1_CLK] = &gcc_video_axi1_clk.clkr,
+	[GCC_DEBUG_MUX] = &gcc_debug_mux.clkr,
 };
 
 static const struct qcom_reset_map gcc_sa8775p_resets[] = {
@@ -4689,6 +4727,16 @@ static int gcc_sa8775p_probe(struct platform_device *pdev)
 	/* FORCE_MEM_CORE_ON for ufs phy ice core clocks */
 	qcom_branch_set_force_mem_core(regmap, gcc_ufs_phy_ice_core_clk, true);
 
+	/* Register mc_cc_debug_mux */
+	mc_cc_debug_mux.clkr.regmap =
+		syscon_regmap_lookup_by_phandle(pdev->dev.of_node, "qcom,mccc");
+	if (IS_ERR(mc_cc_debug_mux.clkr.regmap))
+		return PTR_ERR(mc_cc_debug_mux.clkr.regmap);
+
+	ret = devm_clk_hw_register(&pdev->dev, &mc_cc_debug_mux.clkr.hw);
+	if (ret)
+		return ret;
+
 	return qcom_cc_really_probe(&pdev->dev, &gcc_sa8775p_desc, regmap);
 }
 
