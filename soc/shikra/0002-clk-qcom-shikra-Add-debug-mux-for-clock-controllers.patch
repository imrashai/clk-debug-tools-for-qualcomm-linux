 #include "clk-regmap-divider.h"
@@ -278,6 +279,28 @@ static struct clk_branch gpu_cc_hlos1_vote_gpu_smmu_clk = {
 	},
 };
 
+static struct clk_debug_mux gpu_cc_debug_mux = {
+	.debug_offset = 0x1568,
+	.post_div_offset = 0x10fc,
+	.cbcr_offset = 0x1100,
+	.src_sel_mask = 0xFF,
+	.src_sel_shift = 0,
+	.post_div_mask = 0x3,
+	.post_div_shift = 0,
+	.post_div_val = 2,
+	.clkr = {
+		.hw.init = &(const struct clk_init_data) {
+			.name = "gpu_cc_debug_mux",
+			.parent_data = &(const struct clk_parent_data) {
+				.fw_name = "gcc_debug_mux",
+				.name = "gcc_debug_mux",
+			},
+			.num_parents = 1,
+			.ops = &clk_debug_mux_ops,
+		},
+	},
+};
+
 static struct gdsc gpu_cx_gdsc = {
 	.gdscr = 0x106c,
 	.gds_hw_ctrl = 0x1540,
@@ -319,6 +342,7 @@ static struct clk_regmap *gpu_cc_qcm2290_clocks[] = {
 	[GPU_CC_PLL0] = &gpu_cc_pll0.clkr,
 	[GPU_CC_SLEEP_CLK] = &gpu_cc_sleep_clk.clkr,
 	[GPU_CC_HLOS1_VOTE_GPU_SMMU_CLK] = &gpu_cc_hlos1_vote_gpu_smmu_clk.clkr,
+	[GPU_CC_DEBUG_MUX] = &gpu_cc_debug_mux.clkr,
 };
 
 static const struct qcom_reset_map gpu_cc_qcm2290_resets[] = {
-- 
