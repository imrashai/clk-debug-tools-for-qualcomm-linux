From cfbbc45d9e5d365acb6a5537940b55405652b902 Mon Sep 17 00:00:00 2001
From: Imran Shaik <imran.shaik@oss.qualcomm.com>
Date: Thu, 15 Oct 2026 16:28:31 +0530
Subject: [PATCH 1/3] dt-bindings: clock: qcom: Add debug mux support on Shikra

Add debug mux bindings to measure the clock frequencies on the
Qualcomm Shikra platform.

Signed-off-by: Imran Shaik <imran.shaik@oss.qualcomm.com>
---
 include/dt-bindings/clock/qcom,dispcc-qcm2290.h     | 1 +
 include/dt-bindings/clock/qcom,qcm2290-gpucc.h      | 1 +
 include/dt-bindings/clock/qcom,shikra-audiocorecc.h | 1 +
 include/dt-bindings/clock/qcom,shikra-gcc.h         | 1 +
 4 files changed, 4 insertions(+)

diff --git a/include/dt-bindings/clock/qcom,dispcc-qcm2290.h b/include/dt-bindings/clock/qcom,dispcc-qcm2290.h
index cb687949be41..e0e669d47832 100644
--- a/include/dt-bindings/clock/qcom,dispcc-qcm2290.h
+++ b/include/dt-bindings/clock/qcom,dispcc-qcm2290.h
@@ -28,6 +28,7 @@
 #define DISP_CC_SLEEP_CLK_SRC			18
 #define DISP_CC_XO_CLK				19
 #define DISP_CC_XO_CLK_SRC			20
+#define DISP_CC_DEBUG_MUX			21
 
 /* GDSCs */
 #define MDSS_GDSC				0
diff --git a/include/dt-bindings/clock/qcom,qcm2290-gpucc.h b/include/dt-bindings/clock/qcom,qcm2290-gpucc.h
index 7c76dd05278f..ff000a895689 100644
--- a/include/dt-bindings/clock/qcom,qcm2290-gpucc.h
+++ b/include/dt-bindings/clock/qcom,qcm2290-gpucc.h
@@ -21,6 +21,7 @@
 #define GPU_CC_PLL0			10
 #define GPU_CC_SLEEP_CLK		11
 #define GPU_CC_HLOS1_VOTE_GPU_SMMU_CLK	12
+#define GPU_CC_DEBUG_MUX		13
 
 /* Resets */
 #define GPU_GX_BCR			0
diff --git a/include/dt-bindings/clock/qcom,shikra-audiocorecc.h b/include/dt-bindings/clock/qcom,shikra-audiocorecc.h
index 3052feb627ff..4ad757bdca94 100644
--- a/include/dt-bindings/clock/qcom,shikra-audiocorecc.h
+++ b/include/dt-bindings/clock/qcom,shikra-audiocorecc.h
@@ -41,6 +41,7 @@
 #define AUDIO_CORE_CC_TX_MCLK_2X_CLK				31
 #define AUDIO_CORE_CC_TX_MCLK_CLK				32
 #define AUDIO_CORE_CC_TX_MCLK_RCG_CLK_SRC			33
+#define AUDIO_CORE_CC_DEBUG_MUX					34
 
 /* AUDIO_CORE_CC resets */
 #define AUDIO_CORE_CSR_RX_SWR_CGCR	0
diff --git a/include/dt-bindings/clock/qcom,shikra-gcc.h b/include/dt-bindings/clock/qcom,shikra-gcc.h
index 656c959c7e12..3d07346b6574 100644
--- a/include/dt-bindings/clock/qcom,shikra-gcc.h
+++ b/include/dt-bindings/clock/qcom,shikra-gcc.h
@@ -222,6 +222,7 @@
 #define GCC_VIDEO_VENUS_CLK_SRC					212
 #define GCC_VIDEO_VENUS_CTL_CLK					213
 #define GCC_VIDEO_XO_CLK					214
+#define GCC_DEBUG_MUX						215
 
 /* GCC power domains */
 #define GCC_CAMSS_TOP_GDSC					0
